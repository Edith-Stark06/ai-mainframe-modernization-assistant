APP_NAME=AI Mainframe Modernization Assistant
APP_VERSION=0.1.0

HOST=127.0.0.1
PORT=8000

LOG_LEVEL=INFO

WORKSPACE_DIR=workspace

MAX_UPLOAD_MB=20

# none | ollama | anthropic
LLM_PROVIDER=none
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434
WARM_EMBEDDINGS=false

# Hosted Claude models (LLM_PROVIDER=anthropic). Put real values in .env, which
# is git-ignored -- never in this file. Set an API key, or a bearer token for a
# gateway. Leave ANTHROPIC_BASE_URL blank to use Anthropic's own endpoint.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
