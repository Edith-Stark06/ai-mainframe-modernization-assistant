       IDENTIFICATION DIVISION.
       PROGRAM-ID. INVEXT01.
       AUTHOR. SYNTHETIC-CORPUS.
      * CATEGORY E: BATCH / FILE PROCESSING - INVENTORY STATUS EXTRACT
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INV-MASTER-FILE ASSIGN TO 'INVMAST.DAT'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-INV-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  INV-MASTER-FILE.
       01  FD-INV-RECORD.
           05  FD-ITEM-SKU         PIC X(8).
           05  FD-QTY-ON-HAND      PIC 9(5).
           05  FD-MIN-THRESHOLD    PIC 9(5).
           05  FD-COST-PER-UNIT    PIC 9(4)V99.
       WORKING-STORAGE SECTION.
       01  WS-INV-STATUS           PIC X(2) VALUE '00'.
       01  WS-INV-EOF              PIC X(1) VALUE 'N'.
       01  WS-INVENTORY-TOTALS.
           05  WS-TOTAL-SKU-COUNT  PIC 9(5) VALUE 00000.
           05  WS-REORDER-SKUS     PIC 9(4) VALUE 0000.
           05  WS-TOTAL-ASSET-VAL  PIC 9(9)V99 VALUE 000000000.00.
       01  WS-SKU-CALC.
           05  WS-EXTENDED-VAL     PIC 9(7)V99 VALUE 0000000.00.

       PROCEDURE DIVISION.
       0000-PROCESS-INVENTORY-FILE.
           PERFORM 1000-OPEN-MASTER
           PERFORM 2000-SCAN-ITEMS UNTIL WS-INV-EOF = 'Y'
           PERFORM 3000-CLOSE-MASTER
           GOBACK.

       1000-OPEN-MASTER.
           OPEN INPUT INV-MASTER-FILE
           READ INV-MASTER-FILE INTO FD-INV-RECORD
               AT END MOVE 'Y' TO WS-INV-EOF
           END-READ.

       2000-SCAN-ITEMS.
           ADD 1 TO WS-TOTAL-SKU-COUNT
           COMPUTE WS-EXTENDED-VAL = FD-QTY-ON-HAND * FD-COST-PER-UNIT
           COMPUTE WS-TOTAL-ASSET-VAL = WS-TOTAL-ASSET-VAL + WS-EXTENDED-VAL
           IF FD-QTY-ON-HAND <= FD-MIN-THRESHOLD
               ADD 1 TO WS-REORDER-SKUS
           END-IF
           READ INV-MASTER-FILE INTO FD-INV-RECORD
               AT END MOVE 'Y' TO WS-INV-EOF
           END-READ.

       3000-CLOSE-MASTER.
           CLOSE INV-MASTER-FILE.
