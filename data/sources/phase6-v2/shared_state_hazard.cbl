       IDENTIFICATION DIVISION.
       PROGRAM-ID. SHRHZD01.
       AUTHOR. SYNTHETIC-CORPUS.
      * CATEGORY D: LEGACY ANTI-PATTERNS - SHARED GLOBAL MUTABLE STATE
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  GLOBAL-SHARED-FLAGS.
           05  G-STATUS-FLAG       PIC X(1) VALUE 'N'.
           05  G-GLOBAL-COUNTER    PIC 9(4) VALUE 0000.
           05  G-RUNNING-TOTAL     PIC 9(7)V99 VALUE 0000000.00.
           05  G-LAST-ERROR-MSG    PIC X(30) VALUE SPACES.
           05  G-TEMP-CALC-SLOT    PIC 9(5)V99 VALUE 00000.00.

       PROCEDURE DIVISION.
       0000-MAIN-DISPATCHER.
           PERFORM 1000-SIDE-EFFECT-STEP-ONE
           PERFORM 2000-SIDE-EFFECT-STEP-TWO
           PERFORM 3000-SIDE-EFFECT-STEP-THREE
           GOBACK.

       1000-SIDE-EFFECT-STEP-ONE.
           MOVE 'Y' TO G-STATUS-FLAG
           ADD 1 TO G-GLOBAL-COUNTER
           COMPUTE G-RUNNING-TOTAL = G-RUNNING-TOTAL + 100.00
           MOVE G-RUNNING-TOTAL TO G-TEMP-CALC-SLOT.

       2000-SIDE-EFFECT-STEP-TWO.
           IF G-STATUS-FLAG = 'Y'
               COMPUTE G-TEMP-CALC-SLOT = G-TEMP-CALC-SLOT * 1.50
               ADD 1 TO G-GLOBAL-COUNTER
               MOVE 'P' TO G-STATUS-FLAG
           END-IF.

       3000-SIDE-EFFECT-STEP-THREE.
           IF G-STATUS-FLAG = 'P'
               COMPUTE G-RUNNING-TOTAL = G-TEMP-CALC-SLOT + 25.00
               MOVE 'STEP3-OK' TO G-LAST-ERROR-MSG
           ELSE
               MOVE 'CORRUPTED-GLOBAL-STATE' TO G-LAST-ERROR-MSG
           END-IF.
