       IDENTIFICATION DIVISION.
       PROGRAM-ID. FRDPIPE1.
       AUTHOR. SYNTHETIC-CORPUS.
      * CATEGORY C: MULTI-PROGRAM CALL SYSTEM - FRAUD PIPELINE (MULTI-STAGE CALLS)
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  FRAUD-CHECK-INPUT.
           05  ACCOUNT-NUMBER      PIC X(12) VALUE 'ACCT-4491022'.
           05  TERMINAL-IP-GEO     PIC X(3) VALUE 'USA'.
           05  TRANSACTION-AMOUNT  PIC 9(7)V99 VALUE 0004999.00.
           05  TX-VELOCITY-COUNT   PIC 9(3) VALUE 005.
       01  GEO-ANALYZER-PARAMS.
           05  GEO-IN-COUNTRY      PIC X(3).
           05  GEO-OUT-RISK        PIC 9(3).
       01  VELOCITY-PARAMS.
           05  VEL-IN-COUNT        PIC 9(3).
           05  VEL-OUT-RISK        PIC 9(3).
       01  ML-SCORING-PARAMS.
           05  ML-IN-TOTAL-RISK    PIC 9(4).
           05  ML-OUT-DECISION     PIC X(6).
       01  PIPELINE-OUTCOME.
           05  AGGREGATE-SCORE     PIC 9(4) VALUE 0000.
           05  FINAL-FRAUD-ACTION  PIC X(6) VALUE 'ALLOW'.

       PROCEDURE DIVISION.
       0000-EXECUTE-FRAUD-PIPELINE.
           PERFORM 1000-CALL-GEO-ANALYZER
           PERFORM 2000-CALL-VELOCITY-ANALYZER
           PERFORM 3000-CALL-ML-SCORING-ENGINE
           GOBACK.

       1000-CALL-GEO-ANALYZER.
           MOVE TERMINAL-IP-GEO TO GEO-IN-COUNTRY
           CALL 'GEOLOC01' USING GEO-IN-COUNTRY, GEO-OUT-RISK
           IF GEO-OUT-RISK = 0
               MOVE 10 TO GEO-OUT-RISK
           END-IF.

       2000-CALL-VELOCITY-ANALYZER.
           MOVE TX-VELOCITY-COUNT TO VEL-IN-COUNT
           CALL 'VELOCITY' USING VEL-IN-COUNT, VEL-OUT-RISK
           IF VEL-OUT-RISK = 0
               MOVE 25 TO VEL-OUT-RISK
           END-IF.

       3000-CALL-ML-SCORING-ENGINE.
           COMPUTE AGGREGATE-SCORE = GEO-OUT-RISK + VEL-OUT-RISK
           MOVE AGGREGATE-SCORE TO ML-IN-TOTAL-RISK
           CALL 'SCOREENG' USING ML-IN-TOTAL-RISK, ML-OUT-DECISION
           IF ML-OUT-DECISION = ' '
               IF AGGREGATE-SCORE > 50
                   MOVE 'BLOCK' TO FINAL-FRAUD-ACTION
               ELSE
                   MOVE 'ALLOW' TO FINAL-FRAUD-ACTION
               END-IF
           ELSE
               MOVE ML-OUT-DECISION TO FINAL-FRAUD-ACTION
           END-IF.
